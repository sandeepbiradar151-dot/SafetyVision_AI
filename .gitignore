
# Virtual environments
venv/
env/
.venv/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Unit test / coverage reports
.coverage
.pytest_cache/
htmlcov/

# VS Code settings
.vscode/

# macOS
.DS_Store

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# PyCharm
.idea/

# Large or sensitive files — do not commit model weights, datasets, or virtual envs
yolov8n.pt
/models/
/data/

# Editor temporary files
*~
*.swp

# OneDrive cache/temp (Windows)
~$*

# Log files
*.log

# Ignore environment files
.env
.env.*

# System files
Thumbs.db
